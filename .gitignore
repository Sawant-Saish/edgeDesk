# See https://help.github.com/articles/ignoring-files/

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
pnpm-lock.yaml

# --- Next.js ---
/.next/
/out/
next-env.d.ts

# --- Build / production ---
/build
/dist
*.tsbuildinfo

# --- Environment & secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
# Keep the example template committable
!.env.local.example

# --- Vercel ---
.vercel

# --- Testing ---
/coverage
*.lcov

# --- Logs & debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Editors & IDEs ---
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# VS Code — ignore local settings, keep shared config if added later
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Cursor — local agent/cache artifacts (not project source)
.cursor/

# --- Turbopack / tooling cache ---
.turbo
.eslintcache
.stylelintcache

# --- TypeScript ---
*.tsbuildinfo

# --- Misc ---
*.pem
*.key
*.cert
.cache/
tmp/
temp/
